{
  "primitive": {
    "fontFamily": {
      "$type": "fontFamily",
      "pretendard": {
        "$value": [
          "Pretendard Variable",
          "Pretendard",
          "-apple-system",
          "BlinkMacSystemFont",
          "system-ui",
          "Roboto",
          "Helvetica Neue",
          "Segoe UI",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "Malgun Gothic",
          "sans-serif"
        ],
        "$description": "우리가 fonts/pretendard 로 직접 배포하는 'Pretendard Variable' 이 맨 앞입니다. 로컬에 설치된 static Pretendard 가 먼저 잡히면 기기마다 렌더링이 달라지므로 순서가 중요합니다. 나머지는 웹폰트 로딩 전/실패 시의 폴백입니다."
      }
    },
    "fontSize": {
      "$type": "dimension",
      "100": {
        "$value": "10px"
      },
      "150": {
        "$value": "12px"
      },
      "250": {
        "$value": "14px"
      },
      "350": {
        "$value": "16px"
      },
      "500": {
        "$value": "20px"
      },
      "700": {
        "$value": "24px"
      },
      "750": {
        "$value": "28px"
      },
      "800": {
        "$value": "32px"
      },
      "900": {
        "$value": "36px"
      },
      "1050": {
        "$value": "44px"
      },
      "1150": {
        "$value": "52px"
      }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular-400": {
        "$value": 400
      },
      "medium-500": {
        "$value": 500
      },
      "semibold-600": {
        "$value": 600
      }
    },
    "lineHeight": {
      "$type": "lineHeight",
      "$description": "퍼센트 표기(Figma line-height 방식)를 사용합니다. DTCG 코어에는 퍼센트 타입이 없어 Tokens Studio의 lineHeight 타입을 씁니다.",
      "110": {
        "$value": "110%"
      },
      "130": {
        "$value": "130%"
      },
      "140": {
        "$value": "140%"
      },
      "150": {
        "$value": "150%"
      }
    },
    "letterSpacing": {
      "$type": "letterSpacing",
      "$description": "Figma와 동일하게 퍼센트로 정의합니다. CSS letter-spacing 은 퍼센트를 받지 않으므로 빌드 시 em 으로 변환됩니다(-2% -> -0.02em). em 은 자기 font-size 기준이라 Figma의 퍼센트 의미와 정확히 일치합니다.\n⚠️ Figma Dev Mode 는 이 변수를 단위 없는 -2 로 내보내고 코드 예시에는 -2px 로 적습니다. px 가 아닙니다 — 확인된 값은 퍼센트입니다. 32px 헤드라인 기준 -2% 는 -0.64px 이고 -2px 로 바꾸면 글줄이 16px 좁아집니다.",
      "0": {
        "$value": "0%"
      },
      "n2": {
        "$value": "-2%"
      },
      "n3": {
        "$value": "-3%",
        "$description": "아직 semantic 토큰에서 사용하지 않습니다."
      }
    }
  }
}