{
  "components": {
    "segmentedControl": {
      "$description": "서로 배타적인 선택지를 나란히 놓는 컨트롤. 선택된 항목만 브랜드 색으로 채워집니다.",
      "bg": {
        "$type": "color",
        "$value": "{primitive.colors.whiteAlpha.90}",
        "$description": "순백에서 90% 로 내려갔습니다. 사진 위에 얹히는 컨트롤이라 뒤가 조금 비쳐야 얹힌 것으로 읽힙니다 — 불투명한 흰 면은 사진에서 오려붙인 것처럼 보입니다."
      },
      "border":  { "$type": "color", "$value": "{primitive.colors.seriousGray.alpha900.8}" },
      "rounded": { "$type": "dimension", "$value": "{primitive.rounded.full}" },
      "borderWidth": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "⚠️ Figma 에 변수로 없습니다. 컨테이너 stroke 두께에서 읽었습니다."
      },
      "transition": {
        "$description": "선택 표시가 항목 사이를 미끄러지는 모션.",
        "duration": { "$type": "duration",    "$value": "{primitive.duration.base}" },
        "easing":   { "$type": "cubicBezier", "$value": "{primitive.easing.standard}" }
      },

      "item": {
        "fg":          { "$type": "color", "$value": "{primitive.colors.seriousGray.800}" },
        "fg-disabled": { "$type": "color", "$value": "{primitive.colors.seriousGray.400}", "$description": "고를 수 없는 항목. Figma 의 #C5C3C2 가 seriousGray 400 과 같습니다." },
        "fg-active": { "$type": "color", "$value": "{primitive.colors.white}" },
        "bg-active": { "$type": "color", "$value": "{primitive.colors.twistOrange.500}" },
        "rounded":   { "$type": "dimension", "$value": "{primitive.rounded.full}" }
      }
    }
  }
}
