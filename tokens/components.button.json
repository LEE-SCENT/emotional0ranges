{
  "components": {
    "button": {
      "$description": "type(filled/outlined/ghost/blur) × size(s/m/l) × iconOnly × isOn. isOn 은 반전 상태로 -on 접미사 토큰을 씁니다.",
      "filled": {
        "disabledOpacity": {
          "$type": "number",
          "$value": 0.25,
          "$description": "잠긴 채운 버튼. 색을 갈아끼우지 않고 그대로 흐립니다. ⚠️ 일정 변경 시트는 25%, 결제하기 프레임은 20% 로 그려져 있어 25 로 맞췄습니다 — 같은 버튼의 같은 상태가 화면마다 다를 이유가 없습니다."
        },
        "$type": "color",
        "fg": {
          "$value": "{primitive.colors.white}"
        },
        "bg": {
          "$value": "{primitive.colors.black}"
        },
        "fg-on": {
          "$value": "{semantic.colors.fg}",
          "$description": "반전 상태(흰 배경) 위의 글자색. primitive 가 아니라 semantic 을 참조합니다."
        },
        "bg-on": {
          "$value": "{primitive.colors.white}"
        }
      },
      "outlined": {
        "$type": "color",
        "fg": {
          "$value": "{primitive.colors.seriousGray.900}"
        },
        "bg": {
          "$value": "{semantic.colors.bg}",
          "$description": "흰 배경. 투명하게 두면 사진이나 그라디언트 위에 놓였을 때 테두리 안쪽이 비칩니다."
        },
        "border": {
          "$value": "{primitive.colors.seriousGray.300}"
        },
        "fg-on": {
          "$value": "{primitive.colors.white}"
        },
        "border-on": {
          "$value": "{primitive.colors.seriousGray.300}"
        }
      },
      "ghost": {
        "$type": "color",
        "fg": {
          "$value": "{primitive.colors.seriousGray.700}"
        },
        "fg-on": {
          "$value": "{primitive.colors.white}"
        }
      },
      "blur": {
        "$type": "color",
        "$description": "이미지·영상 위에 올리는 반투명 버튼. 배경이 비쳐야 하므로 alpha 토큰을 씁니다.",
        "fg": {
          "$value": "{primitive.colors.seriousGray.700}"
        },
        "bg": {
          "$value": "{primitive.colors.seriousGray.alpha900.4}"
        },
        "fg-on": {
          "$value": "{primitive.colors.white}"
        },
        "bg-on": {
          "$value": "{primitive.colors.whiteAlpha.15}"
        }
      },
      "rounded": {
        "$type": "dimension",
        "$value": "{primitive.rounded.full}"
      },
      "iconSize": {
        "$type": "dimension",
        "xs": {
          "$value": "{primitive.dimension}",
          "$extensions": {
            "scale": 4
          }
        },
        "s": {
          "$value": "{primitive.dimension}",
          "$extensions": {
            "scale": 5
          }
        },
        "m": {
          "$value": "{primitive.dimension}",
          "$extensions": {
            "scale": 6
          }
        },
        "l": {
          "$value": "{primitive.dimension}",
          "$extensions": {
            "scale": 7
          }
        }
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "⚠️ Figma 에 변수로 없습니다. outlined 의 stroke 두께에서 읽었습니다."
      },
      "blurRadius": {
        "$type": "dimension",
        "$value": "7.5px",
        "$description": "⚠️ Figma 에 변수로 없습니다. blur 타입의 backdrop-blur 값이며, isOn 일 때만 7px 로 달라 확인이 필요합니다."
      }
    }
  }
}