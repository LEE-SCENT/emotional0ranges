{
  "primitive": {
    "colors": {
      "$type": "color",

      "black": { "$value": "#000000" },
      "white": { "$value": "#FFFFFF" },

      "whiteAlpha": {
        "$description": "Figma 경로는 colors/white/alpha/* 이지만, DTCG 에서 토큰(white)은 자식을 가질 수 없어 형제 그룹으로 뒀습니다. CSS 변수명(--colors-white-alpha-15)은 Figma 경로와 동일합니다.",
        "90": {
          "$value": "#FFFFFFE6",
          "$description": "white 를 90% 로. 90% = 0.9×255 = 229.5 이므로 8자리 hex 에서는 E6(90.2%) 로 반올림됩니다. 사진·영상 위에 얹혀도 뒤가 거의 비치지 않는 밝은 면."
        },
        "85": {
          "$value": "#FFFFFFD9",
          "$description": "white 를 85% 로. 85% → D9 (85.1%). 어두운 배경 위 거의 불투명한 밝은 면."
        },
        "15": {
          "$value": "#FFFFFF26",
          "$description": "white 를 15% 로. 15% = 0.15×255 = 38.25 이므로 8자리 hex 에서는 26(14.9%) 으로 반올림됩니다. 어두운 배경·이미지 위에 올리는 밝은 오버레이."
        }
      },

      "twistOrange": {
        "$description": "브랜드 주조색.",
        "50":  { "$value": "#FAE9E6" },
        "100": { "$value": "#FDCCBA" },
        "200": { "$value": "#FBAC8D" },
        "300": { "$value": "#FA8C60" },
        "400": { "$value": "#F8733C" },
        "500": { "$value": "#F75D15" },
        "600": { "$value": "#EC5711" },
        "700": { "$value": "#DF500B" },
        "800": { "$value": "#D14807" },
        "900": { "$value": "#B83C00" },

        "alpha500": {
          "$description": "브랜드 주조색(500)의 반투명 버전.",
          "85": { "$value": "#F75D15D9", "$description": "85% → D9 (85.1%)" }
        }
      },

      "seriousGray": {
        "$description": "텍스트·보더·배경에 쓰는 중립 그레이.",
        "50":  { "$value": "#FDFBFA" },
        "100": { "$value": "#F8F6F5" },
        "200": { "$value": "#F3F1F0" },
        "300": { "$value": "#E7E5E4" },
        "400": { "$value": "#C5C3C2" },
        "500": { "$value": "#A6A4A3" },
        "600": { "$value": "#7D7B7A" },
        "700": { "$value": "#686666" },
        "800": { "$value": "#494746" },
        "900": { "$value": "#272625" },

        "alpha900": {
          "$description": "seriousGray 900 의 반투명 버전. 8자리 hex 의 마지막 두 자리가 알파이며, 퍼센트를 255 스케일로 옮기며 반올림됩니다.",
          "4":  { "$value": "#2726250A", "$description": "4% → 0A (3.92%)" },
          "8":  { "$value": "#27262514", "$description": "8% → 14 (7.84%)" },
          "25": { "$value": "#27262540", "$description": "25% → 40 (25.1%)" }
        }      },

      "casualNeutral": {
        "$description": "따뜻한 톤의 중립색.",
        "50":  { "$value": "#EBE6E2" },
        "100": { "$value": "#CBC0B9" },
        "200": { "$value": "#A8978D" }
      },

      "accentRed": {
        "$description": "경고·오류·할인 강조.",
        "50":  { "$value": "#FFEBEF" },
        "500": { "$value": "#FF383C" }
      },

      "accentGreen": {
        "$description": "성공·완료 상태.",
        "50":  { "$value": "#E5F7E8" },
        "400": { "$value": "#34C759" },
        "500": { "$value": "#00BC37" }
      },

      "accentBlue": {
        "$description": "성별 표시처럼 브랜드색과 짝을 이뤄야 하는 자리. 주조색(주황)의 반대쪽입니다.",
        "400": { "$value": "#195EFF" }
      }
    }
  }
}
